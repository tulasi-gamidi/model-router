# Copy to .env and fill in. Never commit .env.

# DigitalOcean serverless inference key (OpenAI-compatible endpoint). Required.
DO_MODEL_ACCESS_KEY=
# Optional override of the DO base URL (no trailing /chat/completions).
DO_BASE_URL=https://inference.do-ai.run/v1

# Optional: enables the native Anthropic Messages adapter as a second real provider.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Comma-separated keys clients must send as "Authorization: Bearer <key>". Required.
GATEWAY_API_KEYS=dev-key-change-me

PORT=8080
# Optional path to a routes/models manifest (JSON). Defaults to the embedded manifest.
ROUTES_FILE=
# debug | info | warn | error
LOG_LEVEL=info
# Max silence between upstream chunks before the stream is treated as dead (Go duration).
IDLE_TIMEOUT=30s
